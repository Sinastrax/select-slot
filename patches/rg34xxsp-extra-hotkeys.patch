+/// Stateful right analog stick -> distinct virtual buttons, with hysteresis.
+/// No game-button behavior is assigned unless a user explicitly binds it.
+pub struct RightStick {
+    axes: [u16; 2],
+    directions: [i8; 2],
+}
+
+impl RightStick {
+    pub fn new(keymap: Keymap) -> RightStick {
+        RightStick { axes: keymap.right_stick_axes(), directions: [0; 2] }
+    }
+
+    pub fn feed(&mut self, ev: Ev) -> Option<Vec<RawEvent>> {
+        if ev.kind != EV_ABS { return None; }
+        let axis = self.axes.iter().position(|&code| code == ev.code)?;
+        let was = self.directions[axis];
+        let v = ev.value;
+        let now = if was < 0 && v < -RIGHT_RELEASE { -1 }
+            else if was > 0 && v > RIGHT_RELEASE { 1 }
+            else if v < -RIGHT_PRESS { -1 }
+            else if v > RIGHT_PRESS { 1 }
+            else { 0 };
+        if was == now { return Some(Vec::new()); }
+        self.directions[axis] = now;
+        let btn = |dir: i8| match (axis, dir > 0) {
+            (0, false) => Btn::RLeft,
+            (0, true) => Btn::RRight,
+            (1, false) => Btn::RUp,
+            _ => Btn::RDown,
+        };
+        let mut out = Vec::new();
+        if was != 0 { out.push(RawEvent::Up(btn(was))); }
+        if now != 0 { out.push(RawEvent::Down(btn(now))); }
+        Some(out)
+    }
+}
+
