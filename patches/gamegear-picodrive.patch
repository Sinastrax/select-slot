@@ -37,6 +42,47 @@ pub(crate) fn gb_cart_mask(shell: GbShell) -> &'static [u8] {
     let lock = match shell {
         GbShell::Notched => &NOTCHED,
         GbShell::Rounded => &ROUNDED,
+        GbShell::GameGear => {
+            static GAME_GEAR: OnceLock<Vec<u8>> = OnceLock::new();
+            return GAME_GEAR.get_or_init(|| gamegear_silhouette(GB_CART_W, GB_CART_H));
+        }
     };
     lock.get_or_init(|| gb_silhouette(shell, GB_CART_W, GB_CART_H))
 }
+
+/// Game Gear carts have a squared body with clipped shoulders and a wider bottom lip. Keep
+/// this mask separate from the Game Boy pak so the GG shelf reads as its own cartridge system.
+fn gamegear_silhouette(w: u32, h: u32) -> Vec<u8> {
+    let mut mask = vec![0; (w * h) as usize];
+    let sx = w as f32 / GB_CART_W as f32;
+    let sy = h as f32 / GB_CART_H as f32;
+    const POLYGON: [(f32, f32); 8] = [
+        (22.0, 1.0),
+        (290.0, 1.0),
+        (311.0, 20.0),
+        (311.0, 305.0),
+        (296.0, 335.0),
+        (16.0, 335.0),
+        (1.0, 305.0),
+        (1.0, 20.0),
+    ];
+    for y in 0..h {
+        for x in 0..w {
+            let (px, py) = (x as f32 / sx, y as f32 / sy);
+            let mut inside = false;
+            let mut j = POLYGON.len() - 1;
+            for i in 0..POLYGON.len() {
+                let (xi, yi) = POLYGON[i];
+                let (xj, yj) = POLYGON[j];
+                if (yi > py) != (yj > py) && px < (xj - xi) * (py - yi) / (yj - yi) + xi {
+                    inside = !inside;
+                }
+                j = i;
+            }
+            if inside {
+                mask[(y * w + x) as usize] = 255;
+            }
+        }
+    }
+    mask
+}
