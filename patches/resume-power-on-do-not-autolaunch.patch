+#[test]
+fn resume_on_power_on_alone_decides_whether_boot_launches_the_cart() {
+    for (resume_insert, resume_power_on) in [(true, true), (true, false), (false, true), (false, false)] {
+        let d = tmp_root_with_carts(&["Emerald"]);
+        let s = SlotState {
+            resume_insert,
+            resume_power_on,
+            ..seated("Emerald")
+        };
+        write_slot_state(d.path(), &s).unwrap();
+        let a = App::boot(d.path());
+        if resume_power_on {
+            assert!(matches!(a.phase(), Phase::Inserting { .. }));
+            assert!(!a.starting_clean(), "enabled resume should load saved state");
+        } else {
+            assert!(matches!(a.phase(), Phase::Shelf), "disabled resume must show shelf");
+            assert_eq!(a.selected_stem(), Some("Emerald"));
+            assert!(a.seated_cart().is_none(), "disabled resume still seated the cart");
+        }
+    }
+}
+
+#[test]
+fn resume_disabled_still_respects_resume_on_manual_insert() {
+    for resume_insert in [false, true] {
+        let d = tmp_root_with_carts(&["Emerald", "Fusion"]);
+        write_slot_state(
+            d.path(),
+            &SlotState {
+                resume_power_on: false,
+                resume_insert,
+                ..seated("Emerald")
+            },
+        )
+        .unwrap();
+        let mut a = App::boot(d.path());
+        assert!(matches!(a.phase(), Phase::Shelf));
+        assert_eq!(a.selected_stem(), Some("Emerald"));
+        a.apply(Action::Insert);
+        assert!(matches!(a.phase(), Phase::Inserting { .. }));
+        assert_eq!(a.starting_clean(), !resume_insert);
+    }
+}
 
