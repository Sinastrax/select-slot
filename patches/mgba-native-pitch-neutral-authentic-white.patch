+    /// Nonblocking producer for cores whose audio stream can drift ahead of the
+    /// device clock. Preserve the resampling rate (and therefore music pitch)
+    /// instead of blocking the emulator thread when the ring reaches capacity.
+    /// Keep the freshest samples and report any skipped old audio as an overrun.
+    pub fn push_drop_oldest(&self, samples: &[i16]) {
+        if self.muted() || self.capacity_frames() == 0 {
+            self.push(samples);
+            return;
+        }
+        let mut i = self.lock();
+        let cap = i.buf.len();
+        if cap == 0 || samples.is_empty() {
+            return;
+        }
+        // Stereo samples; this method does not change their order or frequency.
+        let fresh = &samples[samples.len().saturating_sub(cap)..];
+        let overflow = i.len.saturating_add(fresh.len()).saturating_sub(cap);
+        if overflow > 0 {
+            i.head = (i.head + overflow) % cap;
+            i.len -= overflow;
+            i.drained += overflow as u64;
+            self.overruns.fetch_add(overflow as u64, Ordering::Relaxed);
+        }
+        let extra = write_into(&mut i, fresh);
+        debug_assert!(extra.is_empty());
+        self.queued.store(i.len, Ordering::Relaxed);
+    }
