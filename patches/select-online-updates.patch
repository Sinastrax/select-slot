+/// select. slot. releases outrank earlier custom, RGSP and pvaibhav builds of the same upstream version.
+/// Keep parsing previous release suffixes so OTA works when migrating existing installations.
+fn fork_version(v: &str) -> Option<(Vec<u64>, u64)> {
+    let (base, fork) = match v.split_once('-') {
+        None => (v, 0),
+        Some((base, suffix)) => {
+            let n = if let Some(s) = suffix.strip_prefix(FORK).and_then(|s| s.strip_prefix('.')) {
+                s.parse::<u64>().ok()?.checked_add(3_000_000)?
+            } else if let Some(s) = suffix.strip_prefix("custom.") {
+                s.parse::<u64>().ok()?.checked_add(2_000_000)?
+            } else if let Some(s) = suffix.strip_prefix("rgsp.") {
+                s.parse::<u64>().ok()?.checked_add(1_000_000)?
+            } else {
+                suffix.strip_prefix("pvaibhav.")?.parse::<u64>().ok()?
+            };
+            (base, n)
+        }
+    };
+    Some((parts(base).filter(|p| p.len() == 3)?, fork))
+}
 
