+#[cfg(test)]
+mod caps_indicator_regression {
+    use super::*;
+    use slot_input::Btn;
+    use slot_ui::{Canvas, Layout};
+
+    #[test]
+    fn locking_and_unlocking_refresh_the_visible_shift_key() {
+        for layout in [Layout::General, Layout::Host] {
+            let mut kb = Keyboard::new(layout, "Test", None, "");
+            let canvas = Canvas::of((640, 480));
+            let shift_faces = |kb: &Keyboard| {
+                let faces = keyboard_cap_faces(kb, canvas);
+                faces[3][0].each_ref().map(|face| face.rgba.clone())
+            };
+            let off = KeyShape::of(&kb).cap_state;
+            let initial = shift_faces(&kb);
+            kb.press(Btn::Select);
+            let once = KeyShape::of(&kb).cap_state;
+            let temporary = shift_faces(&kb);
+            kb.press(Btn::Select);
+            assert_ne!(once, KeyShape::of(&kb).cap_state);
+            let locked = shift_faces(&kb);
+            for focused in 0..2 {
+                assert!(temporary[focused] != locked[focused]);
+            }
+            kb.press(Btn::Select);
+            assert_eq!(off, KeyShape::of(&kb).cap_state);
+            assert!(initial == shift_faces(&kb));
+        }
+    }
+}
