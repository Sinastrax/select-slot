+/// Draw a one-line name inside its own viewport, beside the row's status.
+#[allow(clippy::too_many_arguments)]
+fn push_scrolling_name(
+    out: &mut Vec<Draw>,
+    faces: &QuickMenuFaces,
+    (tex, width, height): (TexId, u32, u32),
+    x: f32,
+    y: f32,
+    right: f32,
+    elapsed_ms: Option<u64>,
+) {
+    let room = (right - x).max(0.0).floor();
+    if width as f32 <= room {
+        push_label(out, faces, (tex, width, height), x, y, elapsed_ms.is_some());
+        return;
+    }
+    let width = width as f32;
+    if room > 0.0 && width > 0.0 {
+        let shown = width.min(room);
+        let offset = elapsed_ms.map_or(0.0, |ms| row_name_offset(width - shown, ms));
+        out.push(Draw::Part {
+            x: x.round(),
+            y: y.round(),
+            w: shown,
+            h: height as f32,
+            tex,
+            alpha: 1.0,
+            uv: [offset / width, 0.0, shown / width, 1.0],
+        });
+    }
+    if elapsed_ms.is_some() {
+        let (pointer, w, h) = faces.pointer;
+        let left = x + MENU_PAD as f32 - POINTER_GAP - w as f32;
+        push(out, pointer, left, y - POINTER_BLEED as f32, w, h);
+    }
+}
+
+/// Pause at each end before reversing so the first and last words can be read.
+fn row_name_offset(overflow: f32, elapsed_ms: u64) -> f32 {
+    const PAUSE_MS: f32 = 850.0;
+    const PIXELS_PER_MS: f32 = 0.050;
+    if overflow <= 0.0 {
+        return 0.0;
+    }
+    let travel_ms = overflow / PIXELS_PER_MS;
+    let leg_ms = travel_ms + PAUSE_MS;
+    let within = elapsed_ms as f32 % (2.0 * leg_ms);
+    let distance = ((within % leg_ms - PAUSE_MS) * PIXELS_PER_MS).clamp(0.0, overflow);
+    if within < leg_ms { distance } else { overflow - distance }
+}
