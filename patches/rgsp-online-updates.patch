+/// Custom RGSP releases sort after the pvaibhav build they were based on.
+/// Accept older pvaibhav versions so users can migrate to our update channel.
+fn fork_version(v: &str) -> Option<(Vec<u64>, u64)> {
+    let (base, fork) = match v.split_once('-') {
+        None => (v, 0),
+        Some((base, suffix)) => {
+            let n = match suffix.strip_prefix(FORK).and_then(|s| s.strip_prefix('.')) {
+                Some(n) => n.parse::<u64>().ok()?.checked_add(1_000_000)?,
+                None => suffix.strip_prefix("pvaibhav.")?.parse().ok()?,
+            };
+            (base, n)
+        }
+    };
+    Some((parts(base).filter(|p| p.len() == 3)?, fork))
+}
 
