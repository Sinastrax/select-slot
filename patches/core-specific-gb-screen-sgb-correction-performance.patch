+#[cfg(test)]
+mod core_screen_profiles_tests {
+    use super::*;
+
+    #[test]
+    fn gb_models_and_shaders_are_independent_and_persisted() {
+        let dir = tempfile::tempdir().unwrap();
+        std::fs::create_dir(dir.path().join("Config")).unwrap();
+        let mut state = SlotState::default();
+        state.cart = Some("Test Game".to_owned());
+        state.shader_gb = Shader::Authentic;
+        state.shader_gb_mgba = Shader::Grid;
+        state.gb_model = GbModel::PocketColor;
+        state.gb_model_mgba = GbModel::PocketSgb;
+        write_slot_state(dir.path(), &state).unwrap();
+        let loaded = read_slot_state(dir.path());
+        assert_eq!(loaded.shader_gb, Shader::Authentic);
+        assert_eq!(loaded.shader_gb_mgba, Shader::Grid);
+        assert_eq!(loaded.gb_model, GbModel::PocketColor);
+        assert_eq!(loaded.gb_model_mgba, GbModel::PocketSgb);
+    }
+
+    #[test]
+    fn old_settings_migrate_without_losing_the_existing_gb_shader() {
+        let dir = tempfile::tempdir().unwrap();
+        std::fs::create_dir(dir.path().join("Config")).unwrap();
+        let mut state = SlotState::default();
+        state.cart = Some("Test Game".to_owned());
+        state.shader_gb = Shader::Authentic;
+        state.gb_model = GbModel::PocketColor;
+        write_slot_state(dir.path(), &state).unwrap();
+        let path = state_path(dir.path());
+        let original = std::fs::read_to_string(&path).unwrap();
+        let old = original
+            .lines()
+            .filter(|line| !line.starts_with("shader_gb_mgba=") && !line.starts_with("gb_model_mgba="))
+            .collect::<Vec<_>>()
+            .join("\n");
+        std::fs::write(&path, old).unwrap();
+        let loaded = read_slot_state(dir.path());
+        assert_eq!(loaded.shader_gb, Shader::Authentic);
+        assert_eq!(loaded.shader_gb_mgba, Shader::Authentic);
+        assert_eq!(loaded.gb_model, GbModel::PocketColor);
+        assert_eq!(loaded.gb_model_mgba, GbModel::PocketSgb);
+    }
+}
