+    /// Return true if this input only wakes the inactive menu's blank display.
+    fn menu_idle_input(&mut self, action: Action) -> bool {
+        // Release signals are not intentional wake actions.
+        if matches!(action, Action::GbaUp(_) | Action::MenuChordUp(_) | Action::PowerOff) {
+            return false;
+        }
+        let woke = self.menu_idle.input(self.now());
+        if !woke {
+            return false;
+        }
+        // Lid-close is about to power off the panel. Do not flash the screen first.
+        if !matches!(action, Action::LidClose) {
+            if let Some(power) = &mut self.power {
+                power.set_idle_blank(false);
+            }
+        }
+        // Consume the subsequent short power-button release rather than re-entering sleep.
+        if matches!(action, Action::PowerPress) {
+            self.woke_on_press = true;
+        }
+        !matches!(
+            action,
+            Action::LidClose | Action::LidOpen | Action::PowerHold | Action::Restart | Action::RepairCard
+        )
+    }
