+++ b/crates/slot-ui/tests/cart.rs
@@ -693,3 +693,24 @@ fn sheet(cart: &slot_store::Cart, rgb: [u8; 3]) -> Vec<u8> {
         .flat_map(|_| [rgb[0], rgb[1], rgb[2], 255])
         .collect()
