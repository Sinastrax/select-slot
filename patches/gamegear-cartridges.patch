+
+#[test]
+fn game_gear_renders_a_dedicated_shell_and_board() {
+    let root = tmp_root();
+    write_gb_rom(&root, "GG", "Game.gg", 0);
+    let mut cart = scan(root.path()).unwrap().into_iter().next().unwrap();
+    assert_eq!(cart.platform, Platform::Gg);
+    assert_eq!(shell_for(&cart).finish, Finish::Solid);
+    assert_eq!(slot_ui::label_size(&cart), (258, 177));
+    let solid = cart_face(&cart);
+    assert_eq!(pixel_alpha(&solid, 156, 5), 0);
+    assert_eq!(pixel_alpha(&solid, 156, 100), 255);
+    cart.shell = Some(slot_store::ShellChoice {
+        outline: slot_store::Outline::Auto,
+        colour: [80, 120, 150],
+        finish: slot_store::ShellFinish::Clear,
+    });
+    let backing = slot_ui::cart_backing(Some(GbShell::GameGear));
+    assert_ne!(backing.rgba, slot_ui::cart_backing(Some(GbShell::Rounded)).rgba);
+    assert_ne!(cart_face(&cart).rgba, solid.rgba);
+}
