+
+#[test]
+fn game_gear_menu_opens_draws_and_resumes() {
+    let (_root, mut app) = playing(Platform::Gg, (640, 480), SlotState::default());
+    app.apply(Action::QuickMenu);
+    assert!(app.in_game_menu().is_some());
+    for row in [QuickRow::ColourCorrection, QuickRow::Reflection] {
+        assert!(app.in_game_hidden().contains(&row));
+        assert_eq!(app.quick_value(row), None);
+    }
+    for _ in 0..120 {
+        app.update(1.0 / 60.0);
+    }
+    let mut draws = Vec::new();
+    app.draw(&mut draws);
+    assert!(!draws.is_empty());
+    app.apply(Action::QuickMenu);
+    assert!(app.in_game_menu().is_none());
+}
+
+#[test]
+fn game_gear_menu_authentic_has_its_own_colour_and_blending() {
+    let (_root, mut app) = playing(Platform::Gg, (640, 480), SlotState {
+        shader_gg: slot_store::Shader::Authentic,
+        ..SlotState::default()
+    });
+    app.apply(Action::QuickMenu);
+    assert!(app.authentic(Platform::Gg));
+    assert_eq!(app.quick_value(QuickRow::ColourCorrection), Some(QuickValue::flag(true)));
+    assert!(!app.in_game_hidden().contains(&QuickRow::ColourCorrection));
+    assert!(app.in_game_hidden().contains(&QuickRow::Reflection));
+    assert_eq!(app.quick_value(QuickRow::Blending), Some(QuickValue::Ghosting));
+    for row in QuickRow::ALL {
+        let _ = app.quick_value(row);
+    }
+}
