+fn achievement_page_positions(canvas: Canvas, header_height: u32, rows: usize) -> (f32, f32, f32) {
+    const HEADER_GAP: f32 = 12.0;
+    let header_top = crate::hud::PLATE_H + 6.0;
+    let centred_top = ((legend_y(canvas) - QUICK_PITCH * rows as f32) / 2.0).max(76.0);
+    let top = centred_top.max(header_top + header_height as f32 + HEADER_GAP);
+    let body_room = (canvas.h - MOUTH_H - top).max(0.0);
+    // Give the header more room by tightening the gaps in a full list.
+    let pitch = (body_room / rows.max(1) as f32).min(QUICK_PITCH);
+    (top - HEADER_GAP - header_height as f32, top, pitch)
