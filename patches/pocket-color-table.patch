--- a/crates/slot-gfx/src/authentic.rs
+++ b/crates/slot-gfx/src/authentic.rs
@@ -98,6 +98,28 @@ pub(crate) fn ramp_texture() -> Vec<u8> {
         .collect()
 }
 
+/// Cache the measured Pocket color conversion for all 32³ source codes.
+pub(crate) fn pocket_color_table() -> Vec<u8> {
+    let look = Screen::Gbc.look();
+    let levels = RAMPS[1].map(|v| look.gamma.map(|g| (f32::from(v) / 255.0).powf(g)));
+    let mut rgba = Vec::with_capacity(256 * 128 * 4);
+    for y in 0..128 {
+        for x in 0..256 {
+            let r = levels[x % 32][0];
+            let g = levels[y % 32][1];
+            let b = levels[(y / 32) * 8 + x / 32][2];
+            for c in 0..3 {
+                let linear = (look.response[c] * r + look.response[3 + c] * g
+                    + look.response[6 + c] * b).clamp(look.least[c], 1.0);
+                let light = look.dark[c] + (look.light[c] - look.dark[c]) * linear;
+                rgba.push((light.max(0.0).powf(1.0 / 2.2) * 255.0).round() as u8);
+            }
+            rgba.push(255);
+        }
+    }
+    rgba
+}
+
 fn rgb(hex: u32) -> [f32; 3] {
     [16, 8, 0].map(|s| ((hex >> s) & 0xff) as f32 / 255.0)
 }
