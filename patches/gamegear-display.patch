+// A dark Game Gear face fitted to Slot's live picture rectangle.
+fn game_gear_bezel(w: u32, h: u32, [left, top, right, bottom]: [i32; 4]) -> Vec<u8> {
+    let mut rgba = Vec::with_capacity(w as usize * h as usize * 4);
+    let lamp_x = w as f32 * 0.5;
+    let lamp_y = top as f32 * 0.5;
+    for y in 0..h as i32 {
+        for x in 0..w as i32 {
+            if x >= left && x < right && y >= top && y < bottom {
+                rgba.extend_from_slice(&[0, 0, 0, 0]);
+                continue;
+            }
+            let lamp = top >= 8 && y < top
+                && ((x as f32 - lamp_x) / 9.0).powi(2)
+                    + ((y as f32 - lamp_y) / 2.0).powi(2) <= 1.0;
+            rgba.extend_from_slice(if lamp { &[68, 208, 103, 255] } else { &[14, 15, 17, 255] });
+        }
+    }
+    rgba
